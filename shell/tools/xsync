#!/bin/bash
# =============================================================
# xsync — 集群文件分发脚本
# 用法: xsync /opt/module/hadoop-3.1.3  (可传多个路径)
# 前置: 到目标主机已配置免密 SSH
# =============================================================

# 目标主机（脚本在 hadoop101 上运行时，分发到 102/103）
SERVERS=(hadoop102 hadoop103)

if [ $# -lt 1 ]; then
    echo "用法: xsync <file_or_dir> [...]"
    exit 1
fi

for file in "$@"; do
    if [ ! -e "$file" ]; then
        echo "错误: $file 不存在，已跳过"
        continue
    fi
    # 解析为绝对路径（rsync 保持目标路径与源路径一致）
    ABS_PATH=$(cd -P "$(dirname "$file")" && pwd)/$(basename "$file")
    for host in "${SERVERS[@]}"; do
        echo "===== 分发 $ABS_PATH 到 $host ====="
        rsync -av --delete "$ABS_PATH" "$host:$ABS_PATH"
    done
done

echo "分发完成"
