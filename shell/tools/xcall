#!/bin/bash
# =============================================================
# xcall — 在集群所有节点执行同一命令
# 用法: xcall "free -g"  /  xcall "jps"
# =============================================================

SERVERS=(hadoop101 hadoop102 hadoop103)

if [ $# -lt 1 ]; then
    echo "用法: xcall <命令>"
    exit 1
fi

for host in "${SERVERS[@]}"; do
    echo "===== $host: $* ====="
    ssh "$host" "$*"
done
